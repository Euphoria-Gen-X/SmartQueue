PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/SmartQueue
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Admin portal (used for /api/admin/auth/login)
